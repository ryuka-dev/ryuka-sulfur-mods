      "key": "plugin.name",
      "value": "Удача за убийство"
    },
    {
      "key": "plugin.description",
      "value": "Даёт удачу при смерти врагов, с настройками награды, фильтров, безопасности и совместимости."
    },
    {
      "key": "section.General",
      "value": "Общее"
    },
    {
      "key": "section.Reward",
      "value": "Награда"
    },
    {
      "key": "section.Compatibility",
      "value": "Совместимость"
    },
    {
      "key": "section.Filter",
      "value": "Фильтр"
    },
    {
      "key": "section.Safety",
      "value": "Безопасность"
