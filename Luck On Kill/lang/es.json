      "key": "plugin.name",
      "value": "Suerte al matar"
    },
    {
      "key": "plugin.description",
      "value": "Otorga suerte cuando mueren enemigos, con opciones de recompensa, filtros, seguridad y compatibilidad."
    },
    {
