      "value": "Tillåt civila enheter att ge tur."
    },
    {
      "key": "entry.Filter.RewardBreakables.name",
      "value": "Belöna förstörbara objekt"
    },
    {
      "key": "entry.Filter.RewardBreakables.description",
      "value": "Tillåt förstörbara enheter att ge tur. Rekommenderas: av."
    },
    {
      "key": "entry.Safety.PreventDuplicateRewards.name",
      "value": "Förhindra dubbla belöningar"
