      "key": "entry.Reward.RewardMultiplier.name",
      "value": "Belöningsmultiplikator vid dödande"
    },
    {
      "key": "entry.Reward.RewardMultiplier.description",
      "value": "Multiplikator för tur som fås när en fiende dör. Basbelöningen är aktuell Stat_LuckGain, lika med en minut original-turåterhämtning."
    },
    {
      "key": "entry.Reward.RewardFlatBonus.name",
      "value": "Fast belöningsbonus vid dödande"
    },
    {
      "key": "entry.Reward.RewardFlatBonus.description",
      "value": "Fast bonus som läggs till turbelöningen efter multiplikatorn."
    },
    {
      "key": "entry.Reward.RewardOverride.name",
      "value": "Åsidosätt belöning vid dödande"
    },
    {
      "key": "entry.Reward.RewardOverride.description",
      "value": "Om värdet är 0 eller högre ersätts turbelöningen med detta fasta värde. -1 inaktiverar detta."
    },
    {
      "key": "entry.Compatibility.ApplyThroughModifyStatus.name",
      "value": "Använd via ModifyStatus"
    },
    {
      "key": "entry.Compatibility.ApplyThroughModifyStatus.description",
      "value": "Använder belöningar via ModifyStatus så att Better Luck Control också kan ändra dem."
    },
    {
      "key": "entry.Filter.RequireHostileToPlayer.name",
