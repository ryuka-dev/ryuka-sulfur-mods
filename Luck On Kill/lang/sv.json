    },
    {
      "key": "entry.Filter.RequireHostileToPlayer.description",
      "value": "Endast enheter som är fientliga mot spelaren ger tur."
    },
    {
      "key": "entry.Filter.RewardOnlyExperienceUnits.name",
      "value": "Kräv XP-enheter"
    },
    {
      "key": "entry.Filter.RewardOnlyExperienceUnits.description",
      "value": "Endast enheter med ExperienceOnKill över 0 ger tur. Lämna av för att tillåta särskilda fientliga fiender med 0 XP."
    },
    {
      "key": "entry.Filter.RewardCivilians.name",
      "value": "Belöna civila"
