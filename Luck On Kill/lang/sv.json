    {
      "key": "entry.Safety.PreventDuplicateRewards.description",
      "value": "Förhindrar att samma enhetsdöd ger tur mer än en gång. Objektpoolens återanvändning hanteras när Unit.Spawn() rensar belöningsstatusen."
    },
    {
      "key": "entry.Debug.LogRewards.name",
