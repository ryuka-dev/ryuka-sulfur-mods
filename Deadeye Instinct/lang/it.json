    {
      "key": "entry.Official Pipeline.EnableMouseConsumesRotationPullDelta.name",
      "value": "Enable Mouse Consumes Rotation Pull Delta"
    },
    {
      "key": "entry.Official Pipeline.EnableMouseConsumesRotationPullDelta.description",
      "value": "Allow mouse input to consume AimAssist.rotationPullDelta inside InputReader.Update()."
