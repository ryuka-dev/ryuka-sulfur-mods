    {
      "key": "entry.Input.RequirePlayerInput.name",
      "value": "Require Player Input"
    },
    {
      "key": "entry.Input.RequirePlayerInput.description",
      "value": "Only assist while player has movement or look input."
    },
    {
      "key": "entry.Input.CountLookInput.name",
      "value": "Count Look Input"
    },
    {
      "key": "entry.Input.CountLookInput.description",
      "value": "Look input counts as active player input."
