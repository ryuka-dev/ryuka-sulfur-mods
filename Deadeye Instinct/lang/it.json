    {
      "key": "entry.Input.MoveInputThreshold.name",
      "value": "Move Input Threshold"
    },
    {
      "key": "entry.Input.MoveInputThreshold.description",
      "value": "Threshold for movement input."
    },
    {
      "key": "entry.Custom Common.AssistCoefficient.name",
      "value": "Assist Coefficient"
    },
    {
      "key": "entry.Custom Common.AssistCoefficient.description",
      "value": "Overall assist strength. 0.6 strong, 1.0 very strong, 2.0 extreme."
    },
    {
      "key": "entry.Custom Common.RotationDeltaPerSecond.name",
      "value": "Rotation Delta Per Second"
    },
    {
      "key": "entry.Custom Common.RotationDeltaPerSecond.description",
      "value": "Base rotationPullDelta per second before AssistCoefficient scaling."
    },
    {
      "key": "entry.Custom Common.MaxRotationDeltaPerFrame.name",
      "value": "Max Rotation Delta Per Frame"
    },
    {
      "key": "entry.Custom Common.MaxRotationDeltaPerFrame.description",
      "value": "Hard cap for added rotationPullDelta per frame."
    },
    {
      "key": "entry.Custom Magnet.MagnetCenterBias.name",
      "value": "Magnet Center Bias"
    },
    {
      "key": "entry.Custom Magnet.MagnetCenterBias.description",
      "value": "For Magnet mode only when weakspot targeting is not available. 0 = official target point, 1 = collider center. Keep low to avoid center locking."
    },
    {
      "key": "entry.Custom Magnet.MagnetMovementOnlyScale.name",
      "value": "Magnet Movement Only Scale"
    },
    {
      "key": "entry.Custom Magnet.MagnetMovementOnlyScale.description",
      "value": "For Magnet mode only. Strength scale when player is moving but not moving aim."
    },
    {
      "key": "entry.Custom Magnet.MagnetSmoothing.name",
      "value": "Magnet Smoothing"
    },
    {
      "key": "entry.Custom Magnet.MagnetSmoothing.description",
      "value": "For Magnet mode only. Active pull smoothing speed. Higher = more responsive."
    },
    {
      "key": "entry.Custom Magnet.MagnetReleaseSmoothing.name",
      "value": "Magnet Release Smoothing"
    },
    {
      "key": "entry.Custom Magnet.MagnetReleaseSmoothing.description",
      "value": "For Magnet mode only. Release smoothing speed. Lower = softer release."
    },
    {
      "key": "entry.Custom Magnet.MagnetPreferWeakspot.name",
      "value": "Magnet Prefer Weakspot"
    },
    {
      "key": "entry.Custom Magnet.MagnetPreferWeakspot.description",
      "value": "For Magnet mode only. Prefer the highest base Hitmesh.Data.GetShapeMultiplier() part when available."
    },
    {
      "key": "entry.Custom Magnet.MagnetWeakspotBias.name",
      "value": "Magnet Weakspot Bias"
    },
    {
      "key": "entry.Custom Magnet.MagnetWeakspotBias.description",
      "value": "For MagnetPreferWeakspot. 0 = normal Magnet target, 1 = weakspot point."
    },
    {
      "key": "entry.Custom Magnet.MagnetWeakspotOverrideOfficialPull.name",
      "value": "Magnet Weakspot Override Official Pull"
    },
    {
      "key": "entry.Custom Magnet.MagnetWeakspotOverrideOfficialPull.description",
      "value": "When Magnet weakspot targeting succeeds, clear the official center pull before adding the weakspot pull."
    },
    {
      "key": "entry.Custom Magnet.MagnetEdgeSofteningPower.name",
      "value": "Magnet Edge Softening Power"
    },
    {
      "key": "entry.Custom Magnet.MagnetEdgeSofteningPower.description",
      "value": "For Magnet mode only. Extra falloff near the outer assist bubble edge. Higher = softer near edge."
    },
    {
      "key": "entry.Custom Magnet.MagnetOuterEdgeStrength.name",
      "value": "Magnet Outer Edge Strength"
    },
    {
      "key": "entry.Custom Magnet.MagnetOuterEdgeStrength.description",
      "value": "For Magnet mode only. Minimum pull strength near the outer edge. Lower reduces snap-back jitter."
    },
    {
      "key": "entry.Custom Magnet.MagnetSnapBackAnglePadding.name",
      "value": "Magnet Snap Back Angle Padding"
    },
    {
      "key": "entry.Custom Magnet.MagnetSnapBackAnglePadding.description",
      "value": "For Magnet mode only. Softly scales down pull during the last N degrees before leaving the bubble."
    },
    {
      "key": "entry.Custom Magnet.MagnetAllowLookAwayEscape.name",
      "value": "Magnet Allow Look Away Escape"
    },
    {
      "key": "entry.Custom Magnet.MagnetAllowLookAwayEscape.description",
      "value": "For Magnet mode only. Reduce pull when player look input is clearly moving away from the target."
    },
    {
      "key": "entry.Custom Magnet.MagnetLookAwayThreshold.name",
      "value": "Magnet Look Away Threshold"
    },
    {
      "key": "entry.Custom Magnet.MagnetLookAwayThreshold.description",
      "value": "For Magnet escape. Dot threshold for detecting look-away input. 0.10 means only clear away input reduces pull."
    },
    {
      "key": "entry.Custom Magnet.MagnetLookAwayMinScale.name",
      "value": "Magnet Look Away Min Scale"
    },
    {
      "key": "entry.Custom Magnet.MagnetLookAwayMinScale.description",
      "value": "For Magnet escape. Minimum pull scale when player strongly looks away. Lower makes controller escape easier."
    },
    {
      "key": "entry.Custom Magnet.MagnetLookAwayCurvePower.name",
      "value": "Magnet Look Away Curve Power"
    },
    {
      "key": "entry.Custom Magnet.MagnetLookAwayCurvePower.description",
      "value": "For Magnet escape. Higher makes pull reduction happen later; lower makes it more sensitive."
    },
    {
      "key": "entry.Custom Magnet.MagnetLookAwayMovementScale.name",
      "value": "Magnet Look Away Movement Scale"
    },
    {
      "key": "entry.Custom Magnet.MagnetLookAwayMovementScale.description",
      "value": "For Magnet escape. Extra scale when movement input is also active. Higher preserves sticky aim while strafing."
    },
    {
      "key": "entry.Custom Target Stability.TargetSwitchFadeSeconds.name",
      "value": "Target Switch Fade Seconds"
    },
    {
      "key": "entry.Custom Target Stability.TargetSwitchFadeSeconds.description",
      "value": "Fade-in time after the official tracked target changes."
    },
    {
      "key": "entry.Custom Target Stability.TargetSwitchMinScale.name",
      "value": "Target Switch Min Scale"
    },
    {
      "key": "entry.Custom Target Stability.TargetSwitchMinScale.description",
      "value": "Minimum assist scale immediately after target switch. 0 = fully fade from zero, 1 = no switch fade."
    },
    {
      "key": "entry.Custom Common.OuterBubbleAngleDegrees.name",
      "value": "Outer Bubble Angle Degrees"
    },
    {
      "key": "entry.Custom Common.OuterBubbleAngleDegrees.description",
      "value": "Target must be inside this angle from crosshair."
    },
    {
      "key": "entry.Custom Common.InnerBubbleAngleDegrees.name",
      "value": "Inner Bubble Angle Degrees"
    },
    {
      "key": "entry.Custom Common.InnerBubbleAngleDegrees.description",
      "value": "Inside this angle, assist reaches full strength."
    },
    {
      "key": "entry.Custom Common.BubbleCurvePower.name",
      "value": "Bubble Curve Power"
    },
    {
      "key": "entry.Custom Common.BubbleCurvePower.description",
      "value": "Higher values make assist weaker near the edge."
    },
    {
      "key": "entry.Custom Common.DistanceFalloffPower.name",
      "value": "Distance Falloff Power"
    },
    {
      "key": "entry.Custom Common.DistanceFalloffPower.description",
      "value": "Higher values make far targets weaker."
    },
    {
      "key": "entry.Custom Natural.NaturalTowardAssist.name",
      "value": "Natural Toward Assist"
    },
    {
      "key": "entry.Custom Natural.NaturalTowardAssist.description",
      "value": "Extra assist when player is already moving aim toward the target. Default 0 means no boost toward target."
    },
    {
      "key": "entry.Custom Natural.NaturalSideAssist.name",
      "value": "Natural Side Assist"
    },
    {
      "key": "entry.Custom Natural.NaturalSideAssist.description",
      "value": "Small assist when player aim input is mostly perpendicular to target direction."
    },
    {
      "key": "entry.Custom Natural.NaturalAwayDamping.name",
      "value": "Natural Away Damping"
    },
    {
      "key": "entry.Custom Natural.NaturalAwayDamping.description",
      "value": "Damping force when player aim input moves away from target."
    },
    {
      "key": "entry.Custom Natural.NaturalMovementOnlyScale.name",
      "value": "Natural Movement Only Scale"
    },
    {
      "key": "entry.Custom Natural.NaturalMovementOnlyScale.description",
      "value": "Assist when only movement input exists and no look input exists. Default 0 disables hands-free pull."
    },
    {
      "key": "entry.Custom Natural.NaturalMaxInputFraction.name",
      "value": "Natural Max Input Fraction"
    },
    {
      "key": "entry.Custom Natural.NaturalMaxInputFraction.description",
      "value": "Natural assist cap as a fraction of current player look input."
    },
    {
      "key": "entry.Custom Natural.NaturalMinDeltaPerFrame.name",
      "value": "Natural Min Delta Per Frame"
    },
    {
      "key": "entry.Custom Natural.NaturalMinDeltaPerFrame.description",
      "value": "Minimum allowed natural delta cap per frame."
    },
    {
      "key": "entry.Custom Natural.NaturalSmoothing.name",
      "value": "Natural Smoothing"
    },
    {
      "key": "entry.Custom Natural.NaturalSmoothing.description",
      "value": "Smoothing speed for natural assist output. Higher is more responsive."
    },
    {
      "key": "entry.Custom Natural.NaturalReleaseSmoothing.name",
      "value": "Natural Release Smoothing"
    },
    {
      "key": "entry.Custom Natural.NaturalReleaseSmoothing.description",
      "value": "Smoothing speed when Natural assist is releasing. Lower = softer release."
    },
    {
      "key": "entry.Custom Natural.NaturalDirectionSmoothing.name",
      "value": "Natural Direction Smoothing"
    },
    {
      "key": "entry.Custom Natural.NaturalDirectionSmoothing.description",
      "value": "Smoothing speed for target direction in Natural mode. Lower reduces jitter from target point changes."
    },
    {
      "key": "entry.Custom Natural.NaturalMinLookInput.name",
      "value": "Natural Min Look Input"
    },
    {
      "key": "entry.Custom Natural.NaturalMinLookInput.description",
      "value": "Minimum look input magnitude before natural aim shaping uses look direction."
    },
    {
      "key": "entry.Custom Natural.NaturalKeepOfficialGamepadPull.name",
      "value": "Natural Keep Official Gamepad Pull"
    },
    {
      "key": "entry.Custom Natural.NaturalKeepOfficialGamepadPull.description",
      "value": "In Natural mode, keep the game's original controller ADS pull. Mouse official ADS pull is still removed."
    },
    {
      "key": "entry.Custom Natural.NaturalReleaseCurvePower.name",
      "value": "Natural Release Curve Power"
    },
    {
      "key": "entry.Custom Natural.NaturalReleaseCurvePower.description",
      "value": "Extra falloff used only by Natural mode. Higher values make assist release more smoothly near the edge of the bubble."
    },
    {
      "key": "entry.Custom Natural.NaturalOuterEdgeStrength.name",
      "value": "Natural Outer Edge Strength"
    },
    {
      "key": "entry.Custom Natural.NaturalOuterEdgeStrength.description",
      "value": "Minimum Natural strength near the outer bubble edge. Keep low to avoid a sudden breakaway feeling."
    },
