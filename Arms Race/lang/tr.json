    },
    {
      "key": "entry.General.ForceSelectGeneratedWeapon.description",
      "value": "Force-select the generated weapon after it is equipped."
    },
    {
      "key": "entry.General.CleanupOldGeneratedWeapons.name",
      "value": "Cleanup Old Generated Weapons"
    },
    {
      "key": "entry.General.CleanupOldGeneratedWeapons.description",
      "value": "Remove older runtime-tagged weapons generated by this mod before generating a new one."
    },
    {
      "key": "entry.Safety.CleanupGeneratedWeaponsBeforeLevelTransition.name",
      "value": "Cleanup Generated Weapons Before Level Transition"
    },
    {
      "key": "entry.Safety.CleanupGeneratedWeaponsBeforeLevelTransition.description",
      "value": "Remove runtime-tagged generated weapons before GameManager.SwitchLevel runs. This prevents generated weapons from entering cross-level equipment data."
    },
    {
      "key": "entry.Safety.DestroyGeneratedWeaponsOnDrop.name",
      "value": "Destroy Generated Weapons On Drop"
    },
    {
      "key": "entry.Safety.DestroyGeneratedWeaponsOnDrop.description",
      "value": "Destroy runtime-tagged generated weapons when the player tries to drop them. This prevents tag loss through ground pickup data."
    },
