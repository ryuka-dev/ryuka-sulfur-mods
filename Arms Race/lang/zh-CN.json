    },
    {
      "key": "entry.Kill Reward.KillRewardRequireExperienceOnKill.description",
      "value": "If true, only units with ExperienceOnKill > 0 can trigger a random weapon reward. This avoids most props and non-enemy objects."
    },
    {
      "key": "entry.Kill Reward.LogKillRewardChecks.name",
